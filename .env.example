# Скопируйте в .env и при необходимости поправьте.

# Путь к клонированному sbe-core относительно этого репозитория.
SBE_CORE_DIR=../sbe-core

# Домен и адрес разработчика для локального auth-service (SMTP не нужен —
# ключ создаёт bootstrap-local-token.sh напрямую в БД).
LOCAL_EMAIL_DOMAIN=tn.ru
LOCAL_EMAIL=dev@tn.ru

# Секрет локального приложения `dev`. Должен совпадать у auth-service и app-service.
LOCAL_SERVICE_SECRET=local-dev-secret
